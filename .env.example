# Server & Security
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/blockcert_db

# SMTP Email Configuration (Nodemailer / Resend / SendGrid / Amazon SES)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="BlockCert Verification" <no-reply@blockcert.io>

# IPFS Pinning Provider (Pinata / IPFS JWT Token)
IPFS_JWT=your_pinata_jwt_token_here

# Polygon Blockchain RPC & Smart Contract
CHAIN_ID=80002
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_PRIVATE_KEY=your_backend_wallet_private_key_here

# App Public URL
FRONTEND_URL=http://localhost:5173
