# ==============================================================================
# BLOCKCERT CCV PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure for your target environment.
# NEVER commit actual secret values into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & SECURITY
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET_KEY
CORS_ORIGIN=https://your-production-domain.edu

# ------------------------------------------------------------------------------
# 2. MONGODB ATLAS / DATABASE
# ------------------------------------------------------------------------------
# Production Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/blockcert_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. PUBLIC APP & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL for public verification links and QR code generation
FRONTEND_URL=https://your-production-domain.edu

# ------------------------------------------------------------------------------
# 4. IPFS STORAGE & PINNING PROVIDER (PINATA)
# ------------------------------------------------------------------------------
PINATA_JWT=YOUR_PRODUCTION_PINATA_JWT_BEARER_TOKEN
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET_KEY=YOUR_PINATA_SECRET_KEY
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ------------------------------------------------------------------------------
# 5. POLYGON BLOCKCHAIN NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# PRODUCTION: Polygon Mainnet (Chain ID: 137)
# DEVELOPMENT / TESTING: Polygon Amoy Testnet (Chain ID: 80002) / Hardhat (31337)
CHAIN_ID=137
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_MAINNET_CONTRACT_ADDRESS
PRIVATE_KEY=0xYOUR_BACKEND_ISSUER_WALLET_PRIVATE_KEY

# ------------------------------------------------------------------------------
# 6. FILE STORAGE & UPLOADS
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_PATH=./uploads
